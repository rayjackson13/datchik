<!--
    The main window: stacks the section panels and the mode switch.
    DataContext: the MainViewModel (set in the code-behind). Each panel gets its own
    section ViewModel through DataContext="{Binding ...}".
-->
<Window x:Class="SysMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SysMonitor.App.Views"
        Title="Datchik"
        Width="320"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        Topmost="True"
        Background="{StaticResource WindowBackgroundBrush}">

    <StackPanel Margin="8,-4,8,12">
        <views:FrameRatePanel DataContext="{Binding FrameRate}" />
        <views:CpuPanel DataContext="{Binding Cpu}" />
        <views:GpuPanel DataContext="{Binding Gpu}" />
        <views:MemoryPanel DataContext="{Binding Memory}" />

        <!-- The mode switch: its text and its action both come from the MainViewModel. -->
        <Button Content="{Binding DisplayModeButtonText}"
                Command="{Binding ToggleDisplayModeCommand}"
                Style="{StaticResource LinkButtonStyle}" />
    </StackPanel>
</Window>
